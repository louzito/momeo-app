# ============================================================
# GENERE PAR SkyBook (App\Tenant\CaddyConfigDumper) — NE PAS EDITER.
# Regenerer : bin/console skybook:proxy:dump (auto a chaque claim/refill).
# Caddy tourne avec --watch : toute regeneration est rechargee seule.
# ============================================================
{
	admin off
	auto_https off
}

:80 {
	# Racine -> centre par defaut
	redir / /skyline/ 302

	# Panel Sylius, profiler, API legacy (tenant par defaut), medias, assets Sylius
	@sylius path /admin* /_profiler* /_wdt* /api/* /media/* /assets/* /build/* /bundles/* /payment-methods/*
	handle @sylius {
		reverse_proxy nginx:80
	}

	# --- centre : demo2
	@demo2_api path_regexp demo2api ^/demo2/api(/.*)?$
	handle @demo2_api {
		uri strip_prefix /demo2
		reverse_proxy nginx:80 {
			header_up X-Skybook-Tenant "demo2"
		}
	}
	redir /demo2 /demo2/ 302
	handle /demo2/* {
		reverse_proxy host.docker.internal:5173
	}

