# ============================================================
# GÉNÉRÉ PAR TodaTempo (App\Service\Tenant\CaddyConfigDumper) — NE PAS ÉDITER.
# Regenerer : bin/console skybook:proxy:dump (auto a chaque claim/refill).
# Caddy tourne avec --watch : toute regeneration est rechargee seule.
# ============================================================
{
	admin off
	auto_https off
}

:80 {
	@unknown_host not host livecode.louzito.fr
	respond @unknown_host "Hôte non reconnu." 404

	# Racine -> centre par defaut
	redir / /todatempo-app/skyline/ 302

	# Panel Sylius, profiler, API legacy (tenant par defaut), medias, assets Sylius
	@sylius path /admin* /_profiler* /_wdt* /api/* /media/* /assets/* /build/* /bundles/* /payment-methods/*
	handle @sylius {
		reverse_proxy nginx:80
	}

	# --- centre : lou-zito
	@lou_zito_0_api path_regexp lou_zito_0api ^/todatempo-app/lou-zito/api(/.*)?$
	handle @lou_zito_0_api {
		uri strip_prefix /todatempo-app/lou-zito
		reverse_proxy nginx:80 {
			header_up X-TodaTempo-Tenant "lou-zito"
		}
	}
	redir /todatempo-app/lou-zito /todatempo-app/lou-zito/ 302
	handle /todatempo-app/lou-zito/* {
		uri strip_prefix /todatempo-app/lou-zito
		rewrite * /api/v2/shop/site/html{uri}
		reverse_proxy nginx:80 {
			header_up X-TodaTempo-Tenant "lou-zito"
		}
	}

	# --- centre : lou-zito
	@lou_zito_1_api path_regexp lou_zito_1api ^/lou-zito/api(/.*)?$
	handle @lou_zito_1_api {
		uri strip_prefix /lou-zito
		reverse_proxy nginx:80 {
			header_up X-TodaTempo-Tenant "lou-zito"
		}
	}
	redir /lou-zito /lou-zito/ 302
	handle /lou-zito/* {
		uri strip_prefix /lou-zito
		rewrite * /api/v2/shop/site/html{uri}
		reverse_proxy nginx:80 {
			header_up X-TodaTempo-Tenant "lou-zito"
		}
	}

	# Assets du dev server Vite (chemins absolus sans slug)
	@vite path /site-assets/* /todatempo-app/site-assets/* /src/* /@vite/* /@id/* /@fs/* /@react-refresh /node_modules/* /favicon* /vite.svg
	handle @vite {
		reverse_proxy host.docker.internal:5173
	}

	# Tout le reste : centre inconnu -> 404 propre
	handle {
		respond "Centre inconnu." 404
	}
}
