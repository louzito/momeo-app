<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnNotice="true"
         failOnWarning="true">
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="0" force="true"/>
        <env name="SKYBOOK_DEFAULT_TENANT" value="demo" force="true"/>
        <server name="KERNEL_CLASS" value="App\Kernel"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>
    <testsuites>
        <testsuite name="TodaTempo business integration">
            <file>tests/Availability/AvailabilitySlotGeneratorTest.php</file>
            <file>tests/Unit/Tenant/TenantContextTest.php</file>
            <file>tests/Integration/Tenant/JwtTenantIsolationTest.php</file>
            <file>tests/Integration/Booking/BookingSlotConcurrencyTest.php</file>
            <file>tests/Controller/StripePaymentContractTest.php</file>
            <file>tests/Integration/Payment/StripeWebhookIdempotencyTest.php</file>
            <file>tests/Unit/GiftVoucher/GiftVoucherTest.php</file>
            <file>tests/Controller/GiftVoucherRedemptionContractTest.php</file>
            <file>tests/Integration/GiftVoucher/GiftVoucherConcurrentRedemptionTest.php</file>
            <file>tests/Integration/Security/TeamPermissionsMatrixTest.php</file>
            <file>tests/Controller/InvoiceSecurityContractTest.php</file>
            <file>tests/Smoke/V1EndToEndSmokeTest.php</file>
        </testsuite>
    </testsuites>
    <source ignoreSuppressionOfDeprecations="true" restrictNotices="true" restrictWarnings="true">
        <include><directory>src</directory></include>
    </source>
</phpunit>
