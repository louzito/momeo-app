# Hébergement à la racine : valeurs par défaut, aucun fichier .env nécessaire.
VITE_APP_BASE=/
VITE_API_BASE=/api/v2
VITE_MEDIA_BASE=

# Pour l'Alias Apache de ce serveur, utiliser dans frontend/.env.local :
# VITE_APP_BASE=/todatempo-app/
# VITE_API_BASE=/todatempo-app/backend/api/v2
# VITE_MEDIA_BASE=/todatempo-app/backend
