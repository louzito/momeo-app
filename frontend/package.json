{
  "name": "todatempo-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Front Vue 3 des espaces professionnels et boutiques de réservation TodaTempo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.* tests/*.test.*",
    "test:e2e": "playwright test",
    "test:production": "vite build && node --test tests/production",
    "test:ci": "npm run test:unit && npm run test:production && npm run test:e2e"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.4",
    "@playwright/test": "1.55.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "vite": "^5.2.0"
  }
}
